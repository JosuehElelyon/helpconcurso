# ============================================================
#  HelpConcurso — variáveis de ambiente
#  Copie para .env e preencha:  cp .env.example .env
# ============================================================

# --- Aplicação ---
NODE_ENV=production
PORT=3000
# Endereço público (usado nos links dos e-mails). Ex.: https://helpconcurso.com.br
APP_URL=http://localhost:3000
# Segredo das sessões — gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# E-mails que viram administradores ao criar/entrar na conta (separados por vírgula)
ADMIN_EMAILS=josuehelelyon@gmail.com
# Cadastro: "allowlist" = só convidados (fase de testes) | "open" = qualquer pessoa
REGISTRATION_MODE=allowlist
# Convidados (separados por vírgula) — coloque aqui o e-mail da Amanda
ALLOWED_EMAILS=

# --- Banco de dados (PostgreSQL) ---
# No docker-compose já vem configurado. Em nuvem (Render, Neon, Supabase...) cole a URL do provedor.
DATABASE_URL=postgresql://helpconcurso:helpconcurso@localhost:5432/helpconcurso
DATABASE_SSL=false

# --- IA ---
# true = respostas simuladas (desenvolver/testar sem gastar créditos)
AI_MOCK=false
# Chaves dos provedores (só precisa das que estiver usando). Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
# Qualquer outra API compatível com OpenAI
COMPAT_API_KEY=
COMPAT_BASE_URL=

# Qual provedor:modelo faz cada tarefa (deixe vazio para usar o padrão). Use "none" no FALLBACK para desativar a reserva.
# Padrões: tarefas pesadas em claude-sonnet-5-5, tarefas simples em claude-haiku-5-5. Exemplos de troca:
#   AI_MODEL_OCR=gemini:gemini-2.5-flash        AI_MODEL_PROVA_EXTRACT=openai:gpt-5-mini
AI_MODEL_DETECT=
AI_MODEL_GENERATE=
AI_MODEL_OCR=
AI_MODEL_PROVA_CHECK=
AI_MODEL_PROVA_ANALYSIS=
AI_MODEL_PROVA_EXTRACT=
AI_FALLBACK_GENERATE=
# "direct" = treino imediato | "batch" = modo lote, mais barato (resposta em minutos/horas; só provedores com lote)
AI_TRAINING_MODE=direct
# Teto de gasto real com IA por dia, em US$ (dia de Brasília). 0 = sem limite. Ao atingir, a IA pausa até o dia seguinte.
AI_LIMITE_USD_DIA=0
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=240000

# --- Segurança e limites ---
UPLOAD_MAX_MB=25
MAX_PDF_PAGES=300
MAX_OCR_PAGES_MATERIAL=30
MAX_OCR_PAGES_PROVA=60
# Antivírus ClamAV opcional (docker compose --profile antivirus up -d)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
# Arquivos bloqueados (críticos) em 24h antes de pausar os envios do usuário
BLOCKED_UPLOADS_BEFORE_LOCK=3
# Aprovações (sem recusas) para as provas do usuário entrarem sem revisão manual
TRUST_AUTO_APPROVE_MIN=5

# --- Revisor automático das questões geradas ---
REVISOR_ATIVO=true
# Gera de novo as questões descartadas pelo revisor (1 rodada)
REVISOR_REFAZER=true

# --- Estrelas (gamificação) ---
ESTRELAS_PROVA_APROVADA=50
ESTRELAS_ERRO_CONFIRMADO=10
ESTRELAS_AVALIACAO=1
ESTRELAS_AVALIACOES_DIA=20
ESTRELAS_POR_GERACAO=10

# --- Cotas por usuário (controle de custo) ---
QUOTA_GERACOES_DIA=30
QUOTA_MATERIAIS_DIA=40
QUOTA_PROVAS_DIA=20
BONUS_POR_PROVA_APROVADA=5

# --- E-mail (SMTP) ---
# Vazio = no Docker usa o Mailpit local (e-mails em http://localhost:8025); fora do Docker, imprime no console.
# Brevo: SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASS=<chave SMTP>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HelpConcurso <nao-responda@seudominio.com.br>"

# --- Arquivos (qualquer serviço compatível com S3) ---
# Local: MinIO do docker-compose. Produção: AWS S3, Cloudflare R2, Backblaze B2...
S3_BUCKET=helpconcurso
S3_REGION=us-east-1
# Deixe vazio para AWS S3. Ex. R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Cria o bucket automaticamente se não existir (útil com MinIO)
S3_CREATE_BUCKET=true

# --- Túnel público (opcional, para usar seu computador como servidor) ---
# Token do Cloudflare Tunnel: veja docs/DEPLOY.md
CLOUDFLARE_TUNNEL_TOKEN=
