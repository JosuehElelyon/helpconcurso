# ============================================================
#  HelpConcurso — variáveis de ambiente
#  Copie para .env e preencha:  cp .env.example .env
# ============================================================

# --- Aplicação ---
NODE_ENV=production
PORT=3000
# Endereço público (usado nos links dos e-mails). Ex.: https://helpconcurso.com.br
APP_URL=http://localhost:3000
# Segredo das sessões — gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# E-mails que viram administradores ao criar/entrar na conta (separados por vírgula)
ADMIN_EMAILS=josuehelelyon@gmail.com
# Cadastro: "allowlist" = só convidados (fase de testes) | "open" = qualquer pessoa
REGISTRATION_MODE=allowlist
# Convidados (separados por vírgula) — coloque aqui o e-mail da Amanda
ALLOWED_EMAILS=

# --- Banco de dados (PostgreSQL) ---
# No docker-compose já vem configurado. Em nuvem (Render, Neon, Supabase...) cole a URL do provedor.
DATABASE_URL=postgresql://helpconcurso:helpconcurso@localhost:5432/helpconcurso
DATABASE_SSL=false

# --- IA ---
# true = respostas simuladas (desenvolver/testar sem gastar créditos)
AI_MOCK=false
# Cascata gratuita: põe os provedores de cota grátis configurados abaixo na frente dos pagos (Claude vira reserva).
# Desligada por padrão. ATENÇÃO: na cota grátis o provedor pode usar o conteúdo enviado (material do aluno) para
# melhorar os produtos dele — avise nos termos de uso. Não crie várias contas para driblar limite (viola os termos).
AI_FREE_CASCADE=false
# true = também nas tarefas pesadas (geração, análise de prova)
AI_FREE_GENERATE=false
# Quais provedores estão em cota grátis (custo 0 no painel e no limite diário). Os não listados são cobrados.
AI_PROVEDORES_GRATIS=
# Provedores autorizados a receber o MATERIAL DO ALUNO (geração, revisão, matéria, cruzamento com edital). Padrão: anthropic
# (não treina com dados da API). Provas e editais (públicos) podem ir para a cascata grátis. Ex. com faturamento Google: anthropic,gemini
AI_PROVEDORES_PRIVADOS=anthropic

# 1. Proxy local Free Claude Code (fcc-server) — só desenvolvimento (precisa do programa aberto no Windows; ignorado em produção)
FCC_ENABLED=false
FCC_API_KEY=
FCC_BASE_URL=http://localhost:8082

# 2. Provedores com cota gratuita (várias chaves separadas por vírgula só se forem da MESMA conta/organização)
# NVIDIA NIM (Gratuito): https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Google AI Studio Gemini (Gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq LPU (Gratuito): https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras Inference (Gratuito): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# SambaNova Cloud (Gratuito): https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# OpenRouter Free Tier (Gratuito): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Mistral La Plateforme (Gratuito): https://console.mistral.ai
MISTRAL_API_KEY=
# Hugging Face Router (Gratuito): https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# Ollama Local (Gratuito, sem internet): https://ollama.com
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:14b

# 3. Provedores Pagos / Reserva Final (só acionados se os gratuitos não estiverem configurados ou falharem)
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
# Qualquer outra API compatível com OpenAI
COMPAT_API_KEY=
COMPAT_BASE_URL=

# Qual provedor:modelo faz cada tarefa (deixe vazio para usar o padrão). Use "none" no FALLBACK para desativar a reserva.
# Padrões: tarefas pesadas em claude-sonnet-5-5, tarefas simples em claude-haiku-5-5. Exemplos de troca:
#   AI_MODEL_OCR=gemini:gemini-2.5-flash        AI_MODEL_PROVA_EXTRACT=openai:gpt-5-mini
AI_MODEL_DETECT=
AI_MODEL_GENERATE=
AI_MODEL_OCR=
AI_MODEL_PROVA_CHECK=
AI_MODEL_PROVA_ANALYSIS=
AI_MODEL_PROVA_EXTRACT=
AI_FALLBACK_GENERATE=
# "direct" = treino imediato | "batch" = modo lote, mais barato (resposta em minutos/horas; só provedores com lote)
AI_TRAINING_MODE=direct
# Teto de gasto real com IA por dia, em US$ (dia de Brasília) e opcional total acumulado. 0 = sem limite.
AI_LIMITE_USD_DIA=0
AI_LIMITE_USD_TOTAL=0
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=240000

# --- Segurança e limites ---
UPLOAD_MAX_MB=25
MAX_PDF_PAGES=300
MAX_OCR_PAGES_MATERIAL=30
MAX_OCR_PAGES_PROVA=60
# Antivírus ClamAV opcional (docker compose --profile antivirus up -d)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
# Arquivos bloqueados (críticos) em 24h antes de pausar os envios do usuário
BLOCKED_UPLOADS_BEFORE_LOCK=3
# Aprovações (sem recusas) para as provas do usuário entrarem sem revisão manual
TRUST_AUTO_APPROVE_MIN=5

# --- Revisor automático das questões geradas ---
REVISOR_ATIVO=true
# Gera de novo as questões descartadas pelo revisor (1 rodada)
REVISOR_REFAZER=true

# --- Estrelas (gamificação) ---
ESTRELAS_PROVA_APROVADA=50
ESTRELAS_ERRO_CONFIRMADO=10
ESTRELAS_AVALIACAO=1
ESTRELAS_AVALIACOES_DIA=20
ESTRELAS_POR_GERACAO=10

# --- Cotas por usuário (controle de custo) ---
QUOTA_GERACOES_DIA=30
QUOTA_MATERIAIS_DIA=40
QUOTA_PROVAS_DIA=20
BONUS_POR_PROVA_APROVADA=5

# --- E-mail (SMTP) ---
# Vazio = no Docker usa o Mailpit local (e-mails em http://localhost:8025); fora do Docker, imprime no console.
# Brevo: SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASS=<chave SMTP>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HelpConcurso <nao-responda@seudominio.com.br>"

# --- Arquivos (qualquer serviço compatível com S3) ---
# Local: MinIO do docker-compose. Produção: AWS S3, Cloudflare R2, Backblaze B2...
S3_BUCKET=helpconcurso
S3_REGION=us-east-1
# Deixe vazio para AWS S3. Ex. R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Cria o bucket automaticamente se não existir (útil com MinIO)
S3_CREATE_BUCKET=true

# --- Túnel público (opcional, para usar seu computador como servidor) ---
# Token do Cloudflare Tunnel: veja docs/DEPLOY.md
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- Topologia (A1–A5) ----------
# PROCESS_ROLE=all           # api | worker | all (padrão: API + fila no mesmo processo)
# SERVIR_FRONT=true          # false quando o front está no Nginx/CDN (docker compose já faz isso)
# CORS_ORIGINS=              # front em outro domínio, ex.: https://app.seudominio.com.br
# TRUST_PROXY=1              # nº de proxies na frente da API (túnel Cloudflare + Nginx = 2)
# WORKER_CONCURRENCY=2

# ---------- LGPD (aparecem nos Termos e na Política de Privacidade) ----------
# LGPD_CONTROLADOR=HelpConcurso
# LGPD_ENCARREGADO="Nome do encarregado (DPO)"
# LGPD_CONTATO=privacidade@seudominio.com.br   # padrão: o e-mail de SMTP_FROM
# LGPD_HOSPEDAGEM="Render Services, Inc."       # quem hospeda a aplicação e o banco (se não for servidor próprio)
# LGPD_HOSPEDAGEM_PAIS="Estados Unidos"

# ---------- Pagamentos (Mercado Pago: Pix e Cartão com liberação na hora) ----------
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...          # Obtenha em mercadopago.com.br/developers (gratuito)
# MERCADOPAGO_PUBLIC_KEY=APP_USR-...
# MERCADOPAGO_WEBHOOK_SECRET=...                # Segredo para validar assinatura do webhook (opcional)

