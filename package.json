{
  "name": "helpconcurso",
  "version": "1.1.0",
  "private": true,
  "description": "HelpConcurso — gere questões de concurso no estilo de cada banca a partir do seu material de estudo.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "make-admin": "node --env-file-if-exists=.env scripts/make-admin.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.13.1",
    "word-extractor": "^1.0.4",
    "zod": "^3.24.1"
  }
}
